{
  "name": "ontario-payroll-v1",
  "private": true,
  "version": "0.1.0",
  "description": "Desktop payroll application for Ontario payroll runs and compliance",
  "author": "Midas Tech Inc.",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "preview": "vite preview",
    "start:server": "node dist-server/index.js",
    "desktop:dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\" \"npm:desktop:wait-and-open\"",
    "desktop:wait-and-open": "wait-on tcp:3001 http://127.0.0.1:5173 && electron .",
    "desktop:build": "npm run build && electron-builder --config electron-builder.json --win nsis --x64",
    "desktop:build:dir": "npm run build && electron-builder --config electron-builder.json --win dir --x64",
    "desktop:publish": "npm run build && electron-builder --config electron-builder.json --win nsis --x64 --publish always",
    "release:desktop": "node scripts/release-desktop.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "electron-updater": "^6.8.3",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^41.1.1",
    "electron-builder": "^26.8.1",
    "tsx": "^4.19.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "wait-on": "^9.0.4"
  },
  "build": {
    "appId": "com.midastech.payroll",
    "productName": "Midas Payroll",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-server/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    }
  }
}
