{
  "appId": "com.midastech.payroll",
  "productName": "Midas Payroll",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "dist-server/**/*",
    "electron/**/*",
    "package.json"
  ],
  "extraMetadata": {
    "main": "electron/main.cjs"
  },
  "asar": false,
  "win": {
    "icon": "build/icon.png",
    "signAndEditExecutable": false,
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true
  },
  "publish": [
    {
      "provider": "github",
      "owner": "midastechinc",
      "repo": "Cursor",
      "releaseType": "release"
    }
  ]
}
